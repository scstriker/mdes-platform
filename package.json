{
  "name": "mdes-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:db": "docker compose up -d db",
    "dev:api": "npm run dev -w @mdes/api",
    "dev:web": "npm run dev -w @mdes/web",
    "seed": "npm run seed -w @mdes/api",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @mdes/shared && npm run build -w @mdes/web && npm run build -w @mdes/api",
    "tokens": "npm run tokens -w @mdes/web",
    "e2e": "npm run e2e -w @mdes/web"
  }
}
